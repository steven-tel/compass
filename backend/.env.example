# Copy to backend/.env for local runs. Never commit .env or bake it into images.

# Required — Gemini
GEMINI_API_KEY=
MODEL=gemini-3.1-flash-live-preview
EXERCISE_DETECTOR_MODEL=gemini-3.5-flash-lite

# Firestore (use ADC / Cloud Run service account; do not ship a key file)
# Required. Put your GCP project id in .env — never commit the real value.
FIRESTORE_PROJECT=
FIRESTORE_DATABASE=compas-database

# Optional — Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_APP_HOST=
